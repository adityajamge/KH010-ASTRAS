# Used when building the Capacitor Android app (npm run build + npx cap sync).
# Your phone can't reach "localhost" (that means the phone itself) — it
# needs your laptop's LAN IP instead, on the same Wi-Fi network.
# If your laptop's Wi-Fi IP changes, update this and rebuild + re-sync.
VITE_API_URL=http://10.252.251.243:8000
# Same Clerk publishable key as .env.development — without this the native
# build shows "Auth not configured" instead of a sign-in screen, since
# vite build (production mode) never reads .env.development.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZGFzaGluZy1wdW1hLTM3MjkuY2xlcmsuYWNjb3VudHMuZGV2JA
