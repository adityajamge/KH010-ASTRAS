# Copy to .env and adjust for local development
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:5173
# Neon Postgres connection string (https://console.neon.tech) — use the
# direct (non-pooled) endpoint, e.g.:
# postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=
# Secret key from the Clerk dashboard (https://dashboard.clerk.com).
# Required for authenticated endpoints — they return 503 until this is set.
CLERK_SECRET_KEY=
# Frontend origins accepted as authorized parties in Clerk session tokens.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# API key from the Anthropic console (https://console.anthropic.com).
# Required for the assistant chat endpoint — it returns 503 until this is set.
ANTHROPIC_API_KEY=
