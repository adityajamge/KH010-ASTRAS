# Copy to .env and adjust for local development
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed frontend origins. https://localhost and
# capacitor://localhost are the Capacitor Android/iOS WebView origins
# (frontend/capacitor.config.ts) — keep them even if you only test the
# website, since the native app shares this same backend.
BACKEND_CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
# Neon Postgres connection string (https://console.neon.tech) — use the
# direct (non-pooled) endpoint, e.g.:
# postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=
# Secret key from the Clerk dashboard (https://dashboard.clerk.com).
# Required for authenticated endpoints — they return 503 until this is set.
CLERK_SECRET_KEY=
# Frontend origins accepted as authorized parties in Clerk session tokens.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://localhost,capacitor://localhost

# AI Coordinator (app/services/llm_client.py) — "anthropic" or "openai".
# Leave the selected provider's key empty to get a friendly "not connected"
# reply on both the website chat and Twilio, instead of an error.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio (https://console.twilio.com) — WhatsApp/SMS prototype channel for
# the same AI Coordinator the website chat uses. Leave empty to disable the
# /api/v1/twilio/inbound webhook (503).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number Twilio assigns, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
# Set to false only for local testing without a public HTTPS URL — keep
# true in any deployed environment.
TWILIO_VALIDATE_SIGNATURE=true
